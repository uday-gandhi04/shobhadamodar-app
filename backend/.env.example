PORT=5000
NODE_ENV=development

# Database Environment Selection:
# Central database selector: default is TEST if missing or set to anything other than explicit 'false'.
# Set USE_TEST_DB=false strictly in production deployment (e.g. Render production environment).
USE_TEST_DB=true

# Test Database Connection (Required for all local development, testing, and test seeding):
MONGODB_URI_TEST=mongodb+srv://<username>:<password>@<test-cluster-url>/shobhadamodar_test_sep2026?retryWrites=true&w=majority

# Production Database Connection (Used strictly when USE_TEST_DB=false):
MONGODB_URI_PROD=mongodb+srv://<username>:<password>@<prod-cluster-url>/<prod_db_name>?retryWrites=true&w=majority
# Compatibility alias for production (must match MONGODB_URI_PROD if both are defined):
MONGO_URI=mongodb+srv://<username>:<password>@<prod-cluster-url>/<prod_db_name>?retryWrites=true&w=majority

# Authentication Secrets:
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
# Required only for initial one-time manager provisioning
AUTH_SEED_SECRET=replace_with_a_long_random_one_time_setup_secret

# Token Lifespans
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
