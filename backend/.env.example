PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<db_name>
# Optional test database isolation:
USE_TEST_DB=false
MONGODB_URI_TEST=mongodb+srv://<username>:<password>@<cluster-url>/shobhadamodar_test_sep2026?retryWrites=true&w=majority

JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
# Required only for one-time initial manager provisioning
AUTH_SEED_SECRET=replace_with_a_long_random_one_time_setup_secret

# Token Lifespans
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
