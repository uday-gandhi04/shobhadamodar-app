# Backend API URL Configuration
# Production API (default used by production release builds: npm run build)
VITE_API_URL=https://shobhadamodar-api.onrender.com/api

# Dedicated Test API (used by test builds: npm run build:test / npm run build:android:test)
# Points to isolated September 2026 test database (shobhadamodar_test_sep2026)
# Default for Android Emulator loopback to host PC:
# VITE_API_URL=http://10.0.2.2:5000/api
# Physical Android device on same Wi-Fi / LAN:
# VITE_API_URL=http://<HOST_COMPUTER_LAN_IP>:5000/api
# Physical Android device via USB ADB reverse (adb reverse tcp:5000 tcp:5000):
# VITE_API_URL=http://localhost:5000/api

# Local Development options (.env / .env.development):
# Web local dev server:
# VITE_API_URL=http://localhost:5000/api

# OTA Live Updates Manifest Configuration
# Production manifest URL:
VITE_OTA_MANIFEST_URL=https://raw.githubusercontent.com/uday-gandhi04/shobhadamodar-app/master/ota/latest.json
# Test/Staging manifest URL:
# VITE_OTA_MANIFEST_URL=https://raw.githubusercontent.com/uday-gandhi04/shobhadamodar-app/master/ota/test-latest.json
