{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare-sql-wasm": "node scripts/copy-sql-wasm.mjs",
    "predev": "npm run prepare-sql-wasm",
    "dev": "vite",
    "prebuild": "npm run prepare-sql-wasm",
    "build": "vite build",
    "prebuild:test": "npm run prepare-sql-wasm",
    "build:test": "vite build --mode test",
    "generate:assets": "python scripts/generate_android_assets.py",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "build:android": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug && cd ..",
    "build:android:test": "npm run build:test && npx cap sync android && cd android && gradlew.bat assembleDebug && cd ..",
    "lint": "eslint .",
    "test:routing": "node --test src/app/routes/routing.regression.test.js",
    "test:ota": "node --test src/services/otaUpdateService.test.js",
    "test:sqlite": "node --test src/database/sqlite.regression.test.js",
    "test:api": "node --test src/services/api.regression.test.js",
    "test": "node --test src/app/routes/routing.regression.test.js src/services/otaUpdateService.test.js src/database/sqlite.regression.test.js src/services/api.regression.test.js",
    "bundle:ota": "npx @capgo/cli bundle zip com.shobhadamodar.app --path ./dist --json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capgo/capacitor-updater": "^8.53.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@ionic/react": "^9.0.2",
    "@ionic/react-router": "^9.0.2",
    "axios": "^1.20.0",
    "currency.js": "^2.0.4",
    "i18next": "^26.4.2",
    "jeep-sqlite": "^2.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-router": "^6.30.6",
    "react-router-dom": "^6.30.6",
    "sql.js": "1.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@capgo/cli": "8.92.2",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
